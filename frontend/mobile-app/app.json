{
  "expo": {
    "name": "GourdVision",
    "slug": "egourd",
    "scheme": "egourd",
    "version": "1.0.1",
    "platforms": [
      "android",
      "ios"
    ],
    "orientation": "portrait",
    "icon": "./assets/logo/gourdvision-high-resolution-logo-green.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/logo/gourdvision-high-resolution-logo-green.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff",
      "hideExpoLoadingScreen": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.coandrei.egourd",
      "infoPlist": {
        "NSCameraUsageDescription": "EGourd needs camera access to scan ampalaya flowers and classify gender for optimal harvest.",
        "NSPhotoLibraryUsageDescription": "EGourd needs photo library access to select ampalaya flower images for analysis.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "android": {
      "package": "com.coandrei.egourd",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo/gourdvision-high-resolution-logo-green.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ],
      "googleServicesFile": "./google-services.json",
      "runtimeVersion": "1.0.0"
    },
    "web": {
      "favicon": "./assets/logo/gourdvision-high-resolution-logo-green.png"
    },
    "plugins": [
      "expo-dev-client",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow EGourd to access your camera to scan ampalaya flowers for gender classification.",
          "microphonePermission": "Allow EGourd to access your microphone for video recording (optional)."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow EGourd to access your photos to select ampalaya flower images for classification."
        }
      ],
      "react-native-fast-tflite",
      "expo-web-browser",
      "expo-font"
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "extra": {
      "eas": {
        "projectId": "79fa9567-ea5a-4e31-a508-d5d97117d4f8"
      }
    },
    "updates": {
      "enabled": true,
      "url": "https://u.expo.dev/79fa9567-ea5a-4e31-a508-d5d97117d4f8",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
