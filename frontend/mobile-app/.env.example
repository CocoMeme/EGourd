# Backend API base URL
# - Local dev (physical device): use your LAN IP from `ipconfig`
# - Deployed (Render): use your Render service URL (HTTPS)
#
# You may provide either `https://host` or `https://host/api`.
EXPO_PUBLIC_API_URL=https://YOUR_BACKEND_HOST_HERE

# Environment
NODE_ENV=development

# Gemini AI Configuration (Optional - for enhanced flower classification)
# Get your API key from: https://makersuite.google.com/app/apikey
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here
EXPO_PUBLIC_ENABLE_GEMINI_VALIDATION=true

