{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "gradleCommand": ":app:assembleDebug",
        "buildType": "apk"
      },
      "ios": {
        "buildConfiguration": "Debug",
        "simulator": false
      }
    },
    "preview": {
      "env": {
        "EXPO_PUBLIC_API_URL": "https://egourd.onrender.com",
        "EXPO_PUBLIC_ENABLE_GEMINI_VALIDATION": "true"
      },
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_API_URL": "https://egourd.onrender.com",
        "EXPO_PUBLIC_ENABLE_GEMINI_VALIDATION": "true"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "buildConfiguration": "Release"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-play-service-account.json"
      },
      "ios": {
        "ascAppId": "placeholder",
        "appleId": "placeholder@example.com",
        "appleTeamId": "placeholder"
      }
    }
  }
}
